# Used by docker-compose for build-time/runtime variable substitution only.
# Per-service config (DB/Redis URLs, CORS, etc.) is set directly in docker-compose.yml's
# `environment:` blocks, since those must point at in-network service names (e.g. `postgres`),
# not localhost. The variables below are the ones docker-compose actually substitutes.

# Signs and verifies JWT access/refresh tokens. Change this to a real secret outside of local dev.
JWT_SECRET_KEY=dev-only-secret-change-in-production

# Stripe is mocked by default (see backend/app/integrations/mock_stripe.py) - no real Stripe
# account is required to run this project. Flip to false + set STRIPE_SECRET_KEY to use real
# Stripe test/live mode; the application code is identical either way.
STRIPE_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_mock_test_secret

# OAuth is implemented for real (Authlib, Google + GitHub authorization-code flow) but has no
# default credentials - the login buttons simply won't complete until you register OAuth apps
# with these providers and set their client id/secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Baked into the frontend's static bundle at build time (Vite inlines import.meta.env.* at
# build, not at container runtime) - must be a build arg, not a normal environment var.
VITE_API_BASE_URL=http://localhost:8020
